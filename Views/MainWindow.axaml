<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MakinaEditor.ViewModels"
        xmlns:views="using:MakinaEditor.Views"
        x:Class="MakinaEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Makina Engine Studio" Width="1440" Height="900"
        Background="#1E1E1E">

    <Panel>
        <views:StartScreenView IsVisible="{Binding !IsProjectLoaded}"/>
        <DockPanel IsVisible="{Binding IsProjectLoaded}">
            <Border DockPanel.Dock="Top" Height="45" Background="#2D2D2D" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                        <TextBlock Text="⚙️" Margin="0,0,8,0" Foreground="#4DB6AC"/>
                        <TextBlock Text="{Binding ProjectName}" FontWeight="Bold" Foreground="#DCDCDC"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                        <RadioButton Content="🖥️ 화면 설계" Classes="ModeTab" IsChecked="{Binding IsUiDesignMode}"/>
                        <RadioButton Content="🗺️ 시나리오 제어" Classes="ModeTab" IsChecked="{Binding IsScenarioMode}"/>
                        <RadioButton Content="📝 플로우 작성" Classes="ModeTab" IsChecked="{Binding IsFlowMode}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0" Spacing="10">
                        <Button Content="💾" ToolTip.Tip="저장" Background="Transparent"/>
                        <Button Content="▶️" ToolTip.Tip="컴파일 및 실행" Foreground="#4CAF50" Background="Transparent"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid ColumnDefinitions="2*, 5*, 3*" IsVisible="{Binding IsFlowMode}">
                    <views:AssetBrowserView Grid.Column="0"/>
                    <Border Grid.Column="1" Background="Black" Margin="10">
                        <TextBlock Text="PREVIEW" Foreground="#00FF00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <views:FlowEditorView Grid.Column="2"/>
                </Grid>

                <Grid IsVisible="{Binding IsScenarioMode}">
                    <TextBlock Text="Scenario Node Graph Editor (Coming Soon)" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid IsVisible="{Binding IsUiDesignMode}">
                    <TextBlock Text="UI Layout Designer (Coming Soon)" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </DockPanel>
    </Panel>
</Window>