<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakinaEditor.ViewModels"
             xmlns:models="using:MakinaEditor.Models"
             x:Class="MakinaEditor.Views.FlowEditorView"
             x:DataType="vm:FlowEditorViewModel">

    <DockPanel Margin="10">
        <!-- 플로우(Flow) 선택 및 관리 영역 -->
        <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                <TextBlock Grid.Column="0" Text="🎬 플로우:" VerticalAlignment="Center" Foreground="#858585" FontSize="11" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFlows}" SelectedItem="{Binding SelectedFlowName}" HorizontalAlignment="Stretch" Height="28" FontSize="11" Background="#1E1E1E" BorderThickness="1" BorderBrush="#3D3D3D"/>
                
                <TextBox Grid.Column="2" Text="{Binding NewFlowNameInput}" PlaceholderText="새 플로우명" Width="90" Height="28" Margin="5,0,0,0" FontSize="11" VerticalContentAlignment="Center" Background="#1E1E1E" BorderThickness="1" BorderBrush="#3D3D3D"/>
                <Button Grid.Column="3" Content="➕" Command="{Binding CreateFlowCommand}" Height="28" Width="28" Margin="2,0,0,0" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="새 플로우 생성" Foreground="#4DB6AC" Background="#2A2A2B"/>
                <Button Grid.Column="4" Content="✕" Command="{Binding DeleteFlowCommand}" Height="28" Width="28" Margin="2,0,0,0" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="현재 플로우 삭제" Foreground="#FF5555" Background="#2A2A2B"/>
            </Grid>
        </Border>

        <!-- 상단 플로우 명령어 추가 버튼 (맨 뒤에 추가됨) -->
        <Button DockPanel.Dock="Top" Content="➕ 연출 명령어 추가" 
                Height="36" CornerRadius="4"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Margin="0,0,0,10" Background="#2A2A2B" BorderBrush="#3D3D3D" BorderThickness="1">
            <Button.Flyout>
                <MenuFlyout Placement="Bottom">
                    <MenuItem Header="💬 대사 출력 추가" Command="{Binding AddTextCommandEnd}"/>
                    <MenuItem Header="🌆 배경 설정 추가" Command="{Binding AddBgCommandEnd}"/>
                    <MenuItem Header="🎭 캐릭터 스탠딩 추가" Command="{Binding AddCharCommandEnd}"/>
                    <MenuItem Header="🎵 BGM 재생 추가" Command="{Binding AddBgmCommandEnd}"/>
                    <MenuItem Header="✨ 셰이더 적용 추가" Command="{Binding AddShaderCommandEnd}"/>
                    <MenuItem Header="📥 선택지 분기 추가" Command="{Binding AddWaitCommandEnd}"/>
                </MenuFlyout>
            </Button.Flyout>
        </Button>

        <DockPanel>
            <!-- 최상단 연출 명령어 삽입 (Gap 0) -->
            <Button DockPanel.Dock="Top" Content="➕" Width="22" Height="22" CornerRadius="11"
                    HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,5" ToolTip.Tip="맨 처음에 연출 삽입">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="💬 대사 출력 추가" Command="{Binding AddTextCommandStart}"/>
                        <MenuItem Header="🌆 배경 설정 추가" Command="{Binding AddBgCommandStart}"/>
                        <MenuItem Header="🎭 캐릭터 스탠딩 추가" Command="{Binding AddCharCommandStart}"/>
                        <MenuItem Header="🎵 BGM 재생 추가" Command="{Binding AddBgmCommandStart}"/>
                        <MenuItem Header="✨ 셰이더 적용 추가" Command="{Binding AddShaderCommandStart}"/>
                        <MenuItem Header="📥 선택지 분기 추가" Command="{Binding AddWaitCommandStart}"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- 타임라인 리스트박스 -->
            <ListBox ItemsSource="{Binding ActiveUserFlow}" 
                      SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                      Background="Transparent" BorderThickness="0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
                
                <ListBox.DataTemplates>
                    <!-- 1. 대사 출력 (PRINT_TEXT) -->
                    <DataTemplate x:DataType="models:TextCommand">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto, *">
                                <!-- 재생 포인터 화살표 -->
                                <TextBlock Grid.Column="0" Text="▶" Foreground="#FFD600" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                           IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                
                                <Border Grid.Column="1" Background="#2B2B2C" BorderBrush="#4DB6AC" BorderThickness="1,0,0,0" CornerRadius="4" Padding="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <!-- 유형 변경 드롭다운 헤더 -->
                                            <Button Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="💬 PRINT_TEXT" Foreground="#4DB6AC" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="▼" Foreground="#4DB6AC" FontSize="8" VerticalAlignment="Center" Opacity="0.5"/>
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuItem Header="💬 대사 출력으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToText}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🌆 배경 설정으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBg}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎭 캐릭터 스탠딩으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToChar}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎵 BGM 재생으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBgm}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="✨ 셰이더 적용으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToShader}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📥 선택지 분기로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToWait}" CommandParameter="{Binding}"/>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>

                                            <TextBox Text="{Binding Speaker}" PlaceholderText="화자 이름" Background="#1E1E1F" BorderThickness="0" Height="26" FontSize="11" VerticalContentAlignment="Center"/>
                                            <TextBox Text="{Binding TextContent}" PlaceholderText="대사 내용" Background="#1E1E1F" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" FontSize="11"/>
                                        </StackPanel>

                                        <!-- 조작 버튼 영역 (위, 아래, 삭제) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,0,0,0" Spacing="2">
                                            <Button Content="▲" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandUp}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="위로 이동"/>
                                            <Button Content="▼" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandDown}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="아래로 이동"/>
                                            <Button Content="✕" Width="20" Height="20" Padding="0" FontSize="10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#FF5555" ToolTip.Tip="삭제"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            
                            <!-- 인라인 추가 버튼 -->
                            <Button Content="➕" Width="22" Height="22" CornerRadius="11"
                                    HorizontalAlignment="Center" Opacity="0.3" Margin="0,5,0,0">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="💬 대사 출력 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddTextCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🌆 배경 설정 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎭 캐릭터 스탠딩 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddCharCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎵 BGM 재생 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgmCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="✨ 셰이더 적용 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddShaderCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="📥 선택지 분기 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddWaitCommand}" CommandParameter="{Binding}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </DataTemplate>

                    <!-- 2. 배경 설정 (SET_BG) -->
                    <DataTemplate x:DataType="models:BgCommand">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto, *">
                                <!-- 재생 포인터 화살표 -->
                                <TextBlock Grid.Column="0" Text="▶" Foreground="#FFD600" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                           IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                
                                <Border Grid.Column="1" Background="#252F3B" BorderBrush="#E74C3C" BorderThickness="1,0,0,0" CornerRadius="4" Padding="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <!-- 유형 변경 드롭다운 헤더 -->
                                            <Button Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="🌆 SET_BG" Foreground="#E74C3C" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="▼" Foreground="#E74C3C" FontSize="8" VerticalAlignment="Center" Opacity="0.5"/>
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuItem Header="💬 대사 출력으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToText}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🌆 배경 설정으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBg}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎭 캐릭터 스탠딩으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToChar}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎵 BGM 재생으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBgm}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="✨ 셰이더 적용으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToShader}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📥 선택지 분기로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToWait}" CommandParameter="{Binding}"/>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>

                                            <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).RegisteredBgs}" SelectedItem="{Binding AssetId}" HorizontalAlignment="Stretch" Height="28" FontSize="11" Background="#171D26" BorderThickness="0"/>
                                        </StackPanel>

                                        <!-- 조작 버튼 영역 (위, 아래, 삭제) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,0,0,0" Spacing="2">
                                            <Button Content="▲" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandUp}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="위로 이동"/>
                                            <Button Content="▼" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandDown}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="아래로 이동"/>
                                            <Button Content="✕" Width="20" Height="20" Padding="0" FontSize="10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#FF5555" ToolTip.Tip="삭제"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            
                            <Button Content="➕" Width="22" Height="22" CornerRadius="11"
                                    HorizontalAlignment="Center" Opacity="0.3" Margin="0,5,0,0">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="💬 대사 출력 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddTextCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🌆 배경 설정 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎭 캐릭터 스탠딩 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddCharCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎵 BGM 재생 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgmCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="✨ 셰이더 적용 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddShaderCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="📥 선택지 분기 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddWaitCommand}" CommandParameter="{Binding}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </DataTemplate>

                    <!-- 3. 캐릭터 설정 (SHOW_CHAR) -->
                    <DataTemplate x:DataType="models:ShowCharCommand">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto, *">
                                <!-- 재생 포인터 화살표 -->
                                <TextBlock Grid.Column="0" Text="▶" Foreground="#FFD600" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                           IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                
                                <Border Grid.Column="1" Background="#31263E" BorderBrush="#9B59B6" BorderThickness="1,0,0,0" CornerRadius="4" Padding="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <!-- 유형 변경 드롭다운 헤더 -->
                                            <Button Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="🎭 SHOW_CHAR" Foreground="#9B59B6" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="▼" Foreground="#9B59B6" FontSize="8" VerticalAlignment="Center" Opacity="0.5"/>
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuItem Header="💬 대사 출력으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToText}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🌆 배경 설정으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBg}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎭 캐릭터 스탠딩으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToChar}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎵 BGM 재생으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBgm}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="✨ 셰이더 적용으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToShader}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📥 선택지 분기로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToWait}" CommandParameter="{Binding}"/>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                            
                                            <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).RegisteredCharacters}" SelectedItem="{Binding CharacterId}" HorizontalAlignment="Stretch" Height="28" FontSize="11" Background="#1F1826" BorderThickness="0"/>
                                            <ComboBox ItemsSource="{Binding AvailablePoses}" SelectedItem="{Binding Pose, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="28" FontSize="11" Background="#1F1826" BorderThickness="0"/>
                                            <TextBox Text="{Binding Position}" PlaceholderText="위치 (Left, Center, Right, Hide)" Background="#1F1826" BorderThickness="0" Height="26" FontSize="11" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- 조작 버튼 영역 (위, 아래, 삭제) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,0,0,0" Spacing="2">
                                            <Button Content="▲" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandUp}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="위로 이동"/>
                                            <Button Content="▼" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandDown}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="아래로 이동"/>
                                            <Button Content="✕" Width="20" Height="20" Padding="0" FontSize="10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#FF5555" ToolTip.Tip="삭제"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            
                            <Button Content="➕" Width="22" Height="22" CornerRadius="11"
                                    HorizontalAlignment="Center" Opacity="0.3" Margin="0,5,0,0">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="💬 대사 출력 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddTextCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🌆 배경 설정 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎭 캐릭터 스탠딩 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddCharCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎵 BGM 재생 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgmCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="✨ 셰이더 적용 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddShaderCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="📥 선택지 분기 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddWaitCommand}" CommandParameter="{Binding}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </DataTemplate>

                    <!-- 4. BGM 재생 (PLAY_BGM) -->
                    <DataTemplate x:DataType="models:PlayBgmCommand">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto, *">
                                <!-- 재생 포인터 화살표 -->
                                <TextBlock Grid.Column="0" Text="▶" Foreground="#FFD600" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                           IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                
                                <Border Grid.Column="1" Background="#1C322C" BorderBrush="#1ABC9C" BorderThickness="1,0,0,0" CornerRadius="4" Padding="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <!-- 유형 변경 드롭다운 헤더 -->
                                            <Button Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="🎵 PLAY_BGM" Foreground="#1ABC9C" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="▼" Foreground="#1ABC9C" FontSize="8" VerticalAlignment="Center" Opacity="0.5"/>
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuItem Header="💬 대사 출력으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToText}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🌆 배경 설정으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBg}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎭 캐릭터 스탠딩으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToChar}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎵 BGM 재생으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBgm}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="✨ 셰이더 적용으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToShader}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📥 선택지 분기로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToWait}" CommandParameter="{Binding}"/>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                            
                                            <TextBox Text="{Binding AssetId}" PlaceholderText="BGM 에셋 ID (예: bgm_peaceful)" Background="#12211D" BorderThickness="0" Height="26" FontSize="11" VerticalContentAlignment="Center"/>
                                            <Grid ColumnDefinitions="Auto, *">
                                                <TextBlock Text="볼륨: " Foreground="#858585" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <Slider Grid.Column="1" Value="{Binding Volume}" Minimum="0" Maximum="1" Height="20"/>
                                            </Grid>
                                        </StackPanel>
                                        
                                        <!-- 조작 버튼 영역 (위, 아래, 삭제) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,0,0,0" Spacing="2">
                                            <Button Content="▲" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandUp}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="위로 이동"/>
                                            <Button Content="▼" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandDown}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="아래로 이동"/>
                                            <Button Content="✕" Width="20" Height="20" Padding="0" FontSize="10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#FF5555" ToolTip.Tip="삭제"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            
                            <Button Content="➕" Width="22" Height="22" CornerRadius="11"
                                    HorizontalAlignment="Center" Opacity="0.3" Margin="0,5,0,0">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="💬 대사 출력 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddTextCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🌆 배경 설정 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎭 캐릭터 스탠딩 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddCharCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎵 BGM 재생 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgmCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="✨ 셰이더 적용 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddShaderCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="📥 선택지 분기 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddWaitCommand}" CommandParameter="{Binding}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </DataTemplate>

                    <!-- 5. 셰이더 적용 (APPLY_SHADER) -->
                    <DataTemplate x:DataType="models:ShaderCommand">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto, *">
                                <!-- 재생 포인터 화살표 -->
                                <TextBlock Grid.Column="0" Text="▶" Foreground="#FFD600" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                           IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                
                                <Border Grid.Column="1" Background="#3D2E20" BorderBrush="#F39C12" BorderThickness="1,0,0,0" CornerRadius="4" Padding="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <!-- 유형 변경 드롭다운 헤더 -->
                                            <Button Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="✨ APPLY_SHADER" Foreground="#F39C12" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="▼" Foreground="#F39C12" FontSize="8" VerticalAlignment="Center" Opacity="0.5"/>
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuItem Header="💬 대사 출력으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToText}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🌆 배경 설정으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBg}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎭 캐릭터 스탠딩으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToChar}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎵 BGM 재생으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBgm}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="✨ 셰이더 적용으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToShader}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📥 선택지 분기로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToWait}" CommandParameter="{Binding}"/>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                            
                                            <TextBox Text="{Binding ShaderId}" PlaceholderText="셰이더 에셋 ID (예: bloom, sepia)" Background="#251C13" BorderThickness="0" Height="26" FontSize="11" VerticalContentAlignment="Center"/>
                                            <Grid ColumnDefinitions="Auto, *">
                                                <TextBlock Text="강도: " Foreground="#858585" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <Slider Grid.Column="1" Value="{Binding Intensity}" Minimum="0" Maximum="2" Height="20"/>
                                            </Grid>
                                        </StackPanel>
                                        
                                        <!-- 조작 버튼 영역 (위, 아래, 삭제) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,0,0,0" Spacing="2">
                                            <Button Content="▲" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandUp}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="위로 이동"/>
                                            <Button Content="▼" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandDown}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="아래로 이동"/>
                                            <Button Content="✕" Width="20" Height="20" Padding="0" FontSize="10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#FF5555" ToolTip.Tip="삭제"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            
                            <Button Content="➕" Width="22" Height="22" CornerRadius="11"
                                    HorizontalAlignment="Center" Opacity="0.3" Margin="0,5,0,0">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="💬 대사 출력 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddTextCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🌆 배경 설정 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎭 캐릭터 스탠딩 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddCharCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎵 BGM 재생 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgmCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="✨ 셰이더 적용 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddShaderCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="📥 선택지 분기 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddWaitCommand}" CommandParameter="{Binding}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </DataTemplate>

                    <!-- 6. 선택지 분기 (WAIT_INPUT) -->
                    <DataTemplate x:DataType="models:WaitInputCommand">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto, *">
                                <!-- 재생 포인터 화살표 -->
                                <TextBlock Grid.Column="0" Text="▶" Foreground="#FFD600" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                           IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                
                                <Border Grid.Column="1" Background="#1E302B" BorderBrush="#2ECC71" BorderThickness="1,0,0,0" CornerRadius="4" Padding="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <!-- 유형 변경 드롭다운 헤더 -->
                                            <Button Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="📥 WAIT_INPUT" Foreground="#2ECC71" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="▼" Foreground="#2ECC71" FontSize="8" VerticalAlignment="Center" Opacity="0.5"/>
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuItem Header="💬 대사 출력으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToText}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🌆 배경 설정으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBg}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎭 캐릭터 스탠딩으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToChar}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="🎵 BGM 재생으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToBgm}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="✨ 셰이더 적용으로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToShader}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📥 선택지 분기로 변경" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).ChangeToWait}" CommandParameter="{Binding}"/>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>

                                            <!-- 선택지 리스트 렌더링 -->
                                            <ItemsControl ItemsSource="{Binding Choices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ChoiceOption">
                                                        <Grid ColumnDefinitions="*, 120, Auto" Margin="0,0,0,4">
                                                            <TextBox Grid.Column="0" Text="{Binding Text}" PlaceholderText="선택지 내용 입력" Height="26" FontSize="11" VerticalContentAlignment="Center" Background="#13201D" BorderThickness="0" Margin="0,0,4,0"/>
                                                            <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AvailableFlows}" SelectedItem="{Binding TargetFlowId}" PlaceholderText="타겟 Flow" Height="26" FontSize="10" Background="#13201D" BorderThickness="0" Margin="0,0,4,0"/>
                                                            <Button Grid.Column="2" Content="✕" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).RemoveChoiceOption}" CommandParameter="{Binding}" Width="22" Height="22" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#FF5555" Background="Transparent" BorderThickness="0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 선택지 추가 버튼 -->
                                            <Button Content="➕ 선택지 옵션 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddChoiceOption}" CommandParameter="{Binding}" Height="24" FontSize="10" Foreground="#2ECC71" Background="Transparent" BorderBrush="#2ECC71" BorderThickness="1"/>
                                        </StackPanel>

                                        <!-- 조작 버튼 영역 (위, 아래, 삭제) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,0,0,0" Spacing="2">
                                            <Button Content="▲" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandUp}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="위로 이동"/>
                                            <Button Content="▼" Width="20" Height="20" Padding="0" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).MoveCommandDown}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#858585" ToolTip.Tip="아래로 이동"/>
                                            <Button Content="✕" Width="20" Height="20" Padding="0" FontSize="10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#FF5555" ToolTip.Tip="삭제"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            
                            <!-- 인라인 추가 버튼 -->
                            <Button Content="➕" Width="22" Height="22" CornerRadius="11"
                                    HorizontalAlignment="Center" Opacity="0.3" Margin="0,5,0,0">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="💬 대사 출력 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddTextCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🌆 배경 설정 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎭 캐릭터 스탠딩 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddCharCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🎵 BGM 재생 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddBgmCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="✨ 셰이더 적용 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddShaderCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="📥 선택지 분기 추가" Command="{Binding $parent[UserControl].((vm:FlowEditorViewModel)DataContext).AddWaitCommand}" CommandParameter="{Binding}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>
        </DockPanel>
    </DockPanel>
</UserControl>